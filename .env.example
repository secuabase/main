# Supabase (staging for local dev; Vercel holds live values for Production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. From Supabase → Project settings → API keys. Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Optional: direct Postgres (transaction pooler, port 6543) for migrations / seed
DATABASE_URL=
# Seed users get this password (seed script + RLS tests)
SEED_PASSWORD=Secuabase-Seed-2026!
# Phase 1 integrations (set when available)
RESEND_API_KEY=
SLACK_WEBHOOK_URL=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Sentry (browser DSN is the same value as SENTRY_DSN; public by design)
NEXT_PUBLIC_SENTRY_DSN=
# Sentry source-map upload at build time (Vercel only). Org slug, project slug, auth token with project:releases scope.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
